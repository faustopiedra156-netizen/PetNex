# Django
SECRET_KEY=django-insecure-cambia-esta-clave
DEBUG=True
APP_NAME=PetNexo
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8081,http://localhost:8081,http://127.0.0.1:8080,http://localhost:8080
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0

# Producción en Render: usa DEBUG=False y tu dominio real.
# Render agrega RENDER_EXTERNAL_HOSTNAME de forma automática.
# DEBUG=False
# ALLOWED_HOSTS=petnexo.onrender.com,petnexo.com,www.petnexo.com
# CSRF_TRUSTED_ORIGINS=https://petnexo.onrender.com,https://petnexo.com,https://www.petnexo.com
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# TRUST_X_FORWARDED_FOR=True

# Base de datos
# Dejalo vacio para usar SQLite local: db.sqlite3
